{
  "name": "@hootask/js",
  "version": "0.0.1",
  "description": "Headless, framework-agnostic Hootask SDK",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RestfullyCare/hootask.git",
    "directory": "packages/js"
  },
  "homepage": "https://github.com/RestfullyCare/hootask/tree/main/packages/js#readme",
  "bugs": "https://github.com/RestfullyCare/hootask/issues",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf .pack && tsdown && pnpm pack --pack-destination .pack && publint --pack pnpm && attw --profile esm-only .pack/*.tgz",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
