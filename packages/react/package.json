{
  "name": "@hootask/react",
  "version": "0.0.1",
  "description": "React bindings for the Hootask SDK",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RestfullyCare/hootask.git",
    "directory": "packages/react"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf .pack && tsdown && pnpm pack --pack-destination .pack && publint --pack pnpm && attw --profile esm-only .pack/*.tgz",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hootask/js": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "publint": "^0.3.0",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
